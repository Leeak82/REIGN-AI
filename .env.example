# REIGN AI production environment variables
# Copy to a host secret store or a local .env that is never committed.
# Nested keys also work in ASP.NET Core: Ai__ApiKey, Sms__Twilio__AuthToken, etc.

# Database (PostgreSQL in production)
# ConnectionStrings__Reign=Host=dpg-xxxx-a;Database=reign;Username=reign;Password=...
# ConnectionStrings__Reign=Host=db.YOUR_PROJECT.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=...;SSL Mode=Require
# Direct db.*.supabase.co is IPv6-only; the API rewrites it to the Session pooler (port 5432).
# Pooler username must be postgres.<project-ref>, not postgres.
# SUPABASE_REGION=us-west-2
# SUPABASE_POOLER_HOST=aws-0-us-west-2.pooler.supabase.com
# SUPABASE_PROJECT_REF=yourprojectref
# SUPABASE_DB_PASSWORD=
# Together these two are enough if ConnectionStrings__Reign is empty.

# Local development fallback (omit ConnectionStrings__Reign to use SQLite REIGN.db)

# Groq
# Ai__ApiKey=
# GROQ_API_KEY=

# SMS
# SMS_PROVIDER=Twilio
# Sms__Provider=Twilio
# Sms__BusinessPhoneNumber=+1
# Sms__OwnerPhoneNumber=+1
# Sms__PublicBaseUrl=https://your-api-host
# Sms__InternalApiKey=
# Sms__AllowInternalSimulator=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_PHONE_NUMBER=
# TWILIO_WEBHOOK_URL=https://your-api-host/api/sms/webhooks/twilio
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_SIGNATURE_SECRET=
# VONAGE_FROM_NUMBER=

# Google Calendar
# GoogleCalendar__Provider=Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Local Docker: docker-compose.yml pins http://localhost:8080/api/integrations/google/callback
# and ignores this host variable so a `dotnet run` value cannot leak :5001 into the container.
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
# Local `dotnet run` (Kestrel HTTPS) only — not used by Docker Compose:
# GOOGLE_REDIRECT_URI=https://localhost:5001/api/integrations/google/callback
# Production:
# GOOGLE_REDIRECT_URI=https://your-api-host/api/integrations/google/callback
# GOOGLE_CALENDAR_ID=j.collins2491@gmail.com
# GOOGLE_CALENDAR_TIMEZONE=America/Los_Angeles

# Host (Render)
# ASPNETCORE_ENVIRONMENT=Production
# DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE=false
# DOTNET_USE_POLLING_FILE_WATCHER=true

# Web UI
# ReignApi__BaseUrl=https://your-api-host/
# REIGN_API_BASE_URL=https://your-api-host/

# Production CORS (comma-separated https origins; never use *)
# Cors__AllowedOrigins=https://your-web-host
# CORS_ALLOWED_ORIGINS=https://your-web-host
