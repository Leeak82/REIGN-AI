# REIGN AI production environment variables
# Copy to a host secret store or a local .env that is never committed.
# Nested keys also work in ASP.NET Core: Ai__ApiKey, Sms__Twilio__AuthToken, etc.

# Database
# ConnectionStrings__Reign=Data Source=/data/REIGN.db
# REIGN_CONNECTION_STRING=Data Source=/data/REIGN.db

# Groq
# Ai__ApiKey=
# GROQ_API_KEY=

# SMS
# SMS_PROVIDER=Twilio
# Sms__Provider=Twilio
# Sms__BusinessPhoneNumber=+1
# Sms__OwnerPhoneNumber=+1
# Sms__PublicBaseUrl=https://your-api-host
# Sms__InternalApiKey=
# Sms__AllowInternalSimulator=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_PHONE_NUMBER=
# TWILIO_WEBHOOK_URL=https://your-api-host/api/sms/webhooks/twilio
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_SIGNATURE_SECRET=
# VONAGE_FROM_NUMBER=

# Google Calendar
# GoogleCalendar__Provider=Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-api-host/api/integrations/google/callback
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_TIMEZONE=America/New_York

# Web UI
# ReignApi__BaseUrl=https://your-api-host/
# REIGN_API_BASE_URL=https://your-api-host/

# Production CORS (comma-separated https origins; never use *)
# Cors__AllowedOrigins=https://your-web-host
# CORS_ALLOWED_ORIGINS=https://your-web-host
