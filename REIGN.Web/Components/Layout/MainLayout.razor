@inherits LayoutComponentBase
@implements IDisposable
@inject ReignApiClient Api

<div class="shell">
    <input type="checkbox" id="nav-toggle" class="nav-toggle" title="Toggle navigation" />

    <aside class="sidebar">
        <NavMenu BusinessName="@BusinessName" Online="@Online" />
    </aside>

    <div class="shell-main">
        <header class="topbar">
            <label for="nav-toggle" class="hamburger" title="Menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </label>

            <div class="top-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                <input placeholder="Search customers by name or phone…"
                       value="@Query"
                       @oninput="OnSearchInput"
                       @onfocus="() => SearchOpen = !string.IsNullOrWhiteSpace(Query)"
                       @onblur="CloseSearchDelayed" />
                @if (SearchOpen && !string.IsNullOrWhiteSpace(Query))
                {
                    <div class="search-results">
                        @if (FilteredCustomers.Count == 0)
                        {
                            <div class="search-empty">No customers match "@Query".</div>
                        }
                        @foreach (var c in FilteredCustomers.Take(6))
                        {
                            <a href="customers/@Uri.EscapeDataString(c.PhoneNumber)" @onmousedown:preventDefault @onclick="ClearSearch">
                                <span>@Fmt.DisplayName(c.Name, c.PhoneNumber)</span>
                                <span class="dim">@c.PhoneNumber</span>
                            </a>
                        }
                    </div>
                }
            </div>

            <div class="topbar-right">
                @if (!string.IsNullOrWhiteSpace(BusinessName))
                {
                    <span class="topbar-biz">@BusinessName</span>
                }

                <a class="live-pill @(Online ? "" : "offline")" href="system" title="System health">
                    <span class="live-dot"></span>
                    <span class="pill-text">@(Online ? "REIGN ONLINE" : "REIGN OFFLINE")</span>
                </a>

                <div class="dropdown">
                    <button class="icon-btn" title="Notifications" @onclick="ToggleNotifications">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                        @if (Notifications.Count > 0)
                        {
                            <span class="dot-badge">@Notifications.Count</span>
                        }
                    </button>
                    @if (NotificationsOpen)
                    {
                        <div class="dropdown-menu">
                            <div class="dropdown-head">Notifications</div>
                            @if (Notifications.Count == 0)
                            {
                                <div class="dropdown-item">
                                    <div>
                                        <div>All clear</div>
                                        <div class="when">REIGN has nothing that needs your attention.</div>
                                    </div>
                                </div>
                            }
                            @foreach (var n in Notifications)
                            {
                                <a class="dropdown-item" href="@n.Link" @onclick="() => NotificationsOpen = false">
                                    <span class="feed-icon @n.IconClass" style="width:32px;height:32px;border-radius:9px;">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="@n.Icon"/></svg>
                                    </span>
                                    <div>
                                        <div>@n.Title</div>
                                        <div class="when">@n.Detail</div>
                                    </div>
                                </a>
                            }
                            <a class="dropdown-foot" href="activity" @onclick="() => NotificationsOpen = false">View all activity</a>
                        </div>
                    }
                </div>

                <div class="dropdown">
                    <button class="avatar-btn" title="Account" @onclick="ToggleProfile">@Fmt.Initials(BusinessName, "R")</button>
                    @if (ProfileOpen)
                    {
                        <div class="dropdown-menu" style="width:240px;">
                            <div class="dropdown-head">@(BusinessName ?? "REIGN AI")</div>
                            <a class="dropdown-item" href="business" @onclick="() => ProfileOpen = false">Business profile</a>
                            <a class="dropdown-item" href="settings" @onclick="() => ProfileOpen = false">Settings</a>
                            <a class="dropdown-item" href="system" @onclick="() => ProfileOpen = false">System health</a>
                        </div>
                    }
                </div>
            </div>
        </header>

        <main class="content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. REIGN couldn't complete that action.
    <a href="." class="reload" style="color:inherit;text-decoration:underline;margin-left:8px;">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private string? BusinessName;
    private bool Online;
    private bool NotificationsOpen;
    private bool ProfileOpen;
    private bool SearchOpen;
    private string Query = "";
    private List<ReignApiClient.CustomerDto> Customers = new();
    private List<NotificationItem> Notifications = new();
    private Timer? _timer;

    private List<ReignApiClient.CustomerDto> FilteredCustomers =>
        string.IsNullOrWhiteSpace(Query)
            ? new()
            : Customers
                .Where(c =>
                    (c.Name?.Contains(Query, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    c.PhoneNumber.Contains(Query, StringComparison.OrdinalIgnoreCase))
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatus();
        _timer = new Timer(async _ =>
        {
            await RefreshStatus();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(45), TimeSpan.FromSeconds(45));
    }

    private async Task RefreshStatus()
    {
        try
        {
            BusinessName = await Api.GetBusinessName() ?? "REIGN";
            var health = await Api.GetHealth();
            Online = health != null && health.Status == "healthy";
            Customers = await Api.GetCustomers();
            BuildNotifications(health);
        }
        catch
        {
            Online = false;
        }
    }

    private void BuildNotifications(ReignApiClient.HealthDto? health)
    {
        var items = new List<NotificationItem>();

        if (health == null || health.Status != "healthy")
        {
            items.Add(new("System degraded",
                "The REIGN API reported a problem. Check System Health.",
                "warn", "M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z", "system"));
        }
        else
        {
            if (!health.SmsConfigured)
            {
                items.Add(new("SMS issue", "SMS is not fully configured.", "warn",
                    "M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.5 2.8.7a2 2 0 0 1 1.7 2Z", "sms"));
            }

            if (!health.CalendarConfigured)
            {
                items.Add(new("Calendar issue", "Google Calendar is not fully configured.", "warn",
                    "M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z", "calendar"));
            }
        }

        foreach (var c in Customers.Where(c => c.HumanOverrideActive).Take(5))
        {
            items.Add(new("Human intervention requested",
                $"{Fmt.DisplayName(c.Name, c.PhoneNumber)} is waiting on the owner.",
                "warn", "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8",
                $"customers/{Uri.EscapeDataString(c.PhoneNumber)}"));
        }

        Notifications = items;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        Query = e.Value?.ToString() ?? "";
        SearchOpen = !string.IsNullOrWhiteSpace(Query);
    }

    private async Task CloseSearchDelayed()
    {
        await Task.Delay(180);
        SearchOpen = false;
    }

    private void ClearSearch()
    {
        Query = "";
        SearchOpen = false;
    }

    private void ToggleNotifications()
    {
        NotificationsOpen = !NotificationsOpen;
        ProfileOpen = false;
    }

    private void ToggleProfile()
    {
        ProfileOpen = !ProfileOpen;
        NotificationsOpen = false;
    }

    public void Dispose() => _timer?.Dispose();

    private record NotificationItem(string Title, string Detail, string IconClass, string Icon, string Link);
}
