@page "/inbox"
@page "/conversations"

@implements IDisposable
@inject ReignApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Inbox — REIGN AI</PageTitle>

<div class="page-head row-flex">
    <div class="grow">
        <h1>Inbox</h1>
        <p>Every customer conversation REIGN is handling.</p>
    </div>
    <button class="btn btn-ghost" @onclick="() => Refresh()" disabled="@Busy">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.6-6.3M21 3v6h-6"/></svg>
        Refresh
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="error-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
        <span class="msg">Something went wrong. REIGN couldn't load the inbox.</span>
        <button class="btn btn-ghost btn-sm" @onclick="() => Refresh()">Try again</button>
    </div>
}

<div class="ws">
    <!-- Conversation list -->
    <div class="ws-col">
        <div class="ws-col-head">
            <h3>Conversations</h3>
            <input class="input" style="margin-top:10px;" placeholder="Search…"
                   @oninput="e => Search = e.Value?.ToString() ?? string.Empty" />
            <div class="conv-filters">
                @foreach (var f in Filters)
                {
                    <button class="chip @(Filter == f ? "on" : "")" @onclick="() => Filter = f">@f</button>
                }
            </div>
        </div>

        <div class="conv-list">
            @if (FilteredCustomers.Count == 0)
            {
                <EmptyState Title="No conversations"
                            Description="REIGN is ready for your next customer." />
            }
            @foreach (var c in FilteredCustomers)
            {
                <button class="conv-item @(Selected?.Id == c.Id ? "sel" : "")" @onclick="() => Select(c)">
                    <div class="conv-top">
                        <span class="conv-name">@Fmt.DisplayName(c.Name, c.PhoneNumber)</span>
                        @if (LastSeen.TryGetValue(c.Id, out var seen))
                        {
                            <span class="conv-time">@Fmt.TimeAgo(seen)</span>
                        }
                    </div>
                    <div class="conv-preview">@c.PhoneNumber · @c.Messages message@(c.Messages == 1 ? "" : "s")</div>
                    <div class="conv-meta">
                        @if (c.HumanOverrideActive)
                        {
                            <StatusBadge Text="Human required" Kind="warning" />
                        }
                        else
                        {
                            <StatusBadge Text="AI handling" Kind="accent" />
                        }
                        @if (IsWaiting(c))
                        {
                            <StatusBadge Text="Waiting" Kind="info" />
                        }
                    </div>
                </button>
            }
        </div>
    </div>

    <!-- Conversation -->
    <div class="ws-col">
        @if (Selected == null)
        {
            <EmptyState Title="Select a conversation"
                        Description="Choose a customer on the left to see the full conversation and reply."
                        Icon="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z" />
        }
        else
        {
            <div class="chat-head">
                <span class="avatar gradient">@Fmt.Initials(Selected.Name, Selected.PhoneNumber)</span>
                <div class="who">
                    <div class="name">@Fmt.DisplayName(Selected.Name, Selected.PhoneNumber)</div>
                    <div class="phone">@Selected.PhoneNumber</div>
                </div>
                @if (Selected.HumanOverrideActive)
                {
                    <StatusBadge Text="Owner speaking" Kind="warning" />
                }
                else
                {
                    <StatusBadge Text="AI handling" Kind="accent" />
                }
            </div>

            @if (Selected.HumanOverrideActive)
            {
                <div class="override-banner">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
                    <span class="grow">REIGN auto-replies are paused. You are speaking as the owner.</span>
                    <button class="btn btn-ghost btn-sm" @onclick="ResumeAi">Resume AI</button>
                </div>
            }

            <div class="chat-scroll" id="chat-scroll">
                @if (Messages.Count == 0)
                {
                    <EmptyState Title="No messages yet"
                                Description="When this customer texts REIGN, the conversation appears here." />
                }
                @foreach (var m in Messages)
                {
                    var outbound = m.Direction == "Outbound";
                    <div class="bubble-row @(outbound ? "out" : "in")">
                        <span class="bubble-tag">@(outbound ? (m.IsOwnerOverride ? "OWNER" : "REIGN") : "CUSTOMER")</span>
                        <div class="bubble">@m.Body</div>
                        <span class="bubble-time">@Fmt.TimeAgo(m.CreatedAt)</span>
                    </div>
                }
            </div>

            <div class="composer">
                <textarea id="composer" class="textarea" placeholder="Reply as the business…" @oninput="e => Draft = e.Value?.ToString() ?? string.Empty"></textarea>
                <button class="btn btn-ghost" title="AI Assist" @onclick="AiAssist" disabled="@(Busy || Selected == null)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3 1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3Z"/></svg>
                    AI Assist
                </button>
                <button class="btn btn-primary" @onclick="Send" disabled="@(Busy || string.IsNullOrWhiteSpace(Draft))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                    Send
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(Notice))
            {
                <div style="padding:0 18px 14px;">
                    <span class="badge badge-info">@Notice</span>
                </div>
            }
        }
    </div>

    <!-- Customer intelligence -->
    <div class="ws-col ws-right">
        @if (Selected == null)
        {
            <EmptyState Title="Customer intelligence"
                        Description="Details about the selected customer appear here."
                        Icon="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8" />
        }
        else
        {
            <div class="panel-scroll">
                <div class="panel-section">
                    <h4>Customer</h4>
                    <div class="kv"><span class="k">Name</span><span class="v">@(Selected.Name ?? "—")</span></div>
                    <div class="kv"><span class="k">Phone</span><span class="v">@Selected.PhoneNumber</span></div>
                    <div class="kv"><span class="k">Messages</span><span class="v">@Selected.Messages</span></div>
                    <div class="kv"><span class="k">Appointments</span><span class="v">@Selected.Appointments</span></div>
                    <a class="btn btn-ghost btn-sm mt-1" href="customers/@Uri.EscapeDataString(Selected.PhoneNumber)">Full profile</a>
                </div>

                <div class="panel-section">
                    <h4>Conversation</h4>
                    <div class="kv"><span class="k">Status</span><span class="v">@(Selected.ConversationStatus ?? "—")</span></div>
                    <div class="kv"><span class="k">Turns</span><span class="v">@Selected.TurnCount</span></div>
                    @if (LastSeen.TryGetValue(Selected.Id, out var last))
                    {
                        <div class="kv"><span class="k">Last activity</span><span class="v">@Fmt.TimeAgo(last)</span></div>
                    }
                </div>

                <div class="panel-section">
                    <h4>REIGN</h4>
                    <div class="kv"><span class="k">Current intent</span><span class="v">@(string.IsNullOrWhiteSpace(Selected.CurrentIntent) ? "—" : Fmt.Label(Selected.CurrentIntent))</span></div>
                    <div class="kv"><span class="k">Pending service</span><span class="v">@(Selected.PendingServiceName ?? "—")</span></div>
                    <div class="kv"><span class="k">Human needed</span><span class="v">@(Selected.HumanOverrideActive ? "Yes" : "No")</span></div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Selected.MemorySummary))
                {
                    <div class="panel-section">
                        <h4>What REIGN remembers</h4>
                        <p class="small dim" style="margin:0;white-space:pre-wrap;">@Selected.MemorySummary</p>
                    </div>
                }

                <div class="panel-section">
                    <h4>Appointments</h4>
                    @if (Appointments.Count == 0)
                    {
                        <p class="small faint" style="margin:0;">No appointments for this customer.</p>
                    }
                    @foreach (var a in Appointments)
                    {
                        <div style="padding:10px 0;border-bottom:1px solid rgba(148,163,184,0.07);">
                            <div class="row-flex">
                                <div class="grow">
                                    <div style="font-weight:600;font-size:13.5px;">@a.Service</div>
                                    <div class="small faint">@Fmt.AppointmentTime(a.AppointmentTime) · @Fmt.Money(a.Price)</div>
                                </div>
                                <StatusBadge Text="@a.Status" Kind="@StatusBadge.KindForAppointment(a.Status)" />
                            </div>
                            @if (a.Status == "Pending" || a.Status == "Confirmed")
                            {
                                <div class="row-flex mt-1">
                                    @if (a.Status == "Pending")
                                    {
                                        <button class="btn btn-success btn-sm" @onclick="() => Confirm(a.Id)">Confirm</button>
                                    }
                                    <button class="btn btn-danger btn-sm" @onclick="() => Cancel(a.Id)">Cancel</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private static readonly string[] Filters = ["All", "Waiting", "Active", "AI handled", "Human required"];

    private List<ReignApiClient.CustomerDto> Customers = new();
    private List<ReignApiClient.MessageDto> Messages = new();
    private List<ReignApiClient.AppointmentDto> Appointments = new();
    private List<ReignApiClient.RecentActivityDto> Recent = new();
    private ReignApiClient.CustomerDto? Selected;
    private string Filter = "All";
    private string Search = "";
    private string Draft = "";
    private string Notice = "";
    private string Error = "";
    private bool Busy;
    private Timer? _timer;

    private Dictionary<Guid, DateTime> LastSeen =>
        Recent
            .GroupBy(r => r.Customer)
            .Select(g => g.OrderByDescending(r => r.Time).First())
            .SelectMany(latest => Customers
                .Where(c => c.PhoneNumber == latest.Customer || c.Name == latest.Customer)
                .Select(c => (c.Id, latest.Time)))
            .GroupBy(x => x.Id)
            .ToDictionary(g => g.Key, g => g.Max(x => x.Time));

    private List<string> WaitingPhones =>
        Recent
            .GroupBy(r => r.Customer)
            .Where(g => g.OrderByDescending(r => r.Time).First().Direction == "Inbound")
            .Select(g => g.Key)
            .ToList();

    private bool IsWaiting(ReignApiClient.CustomerDto c) =>
        WaitingPhones.Contains(c.PhoneNumber) ||
        (c.Name != null && WaitingPhones.Contains(c.Name));

    private List<ReignApiClient.CustomerDto> FilteredCustomers
    {
        get
        {
            IEnumerable<ReignApiClient.CustomerDto> q = Customers;

            if (!string.IsNullOrWhiteSpace(Search))
            {
                q = q.Where(c =>
                    (c.Name?.Contains(Search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    c.PhoneNumber.Contains(Search, StringComparison.OrdinalIgnoreCase));
            }

            q = Filter switch
            {
                "Waiting" => q.Where(IsWaiting),
                "Active" => q.Where(c => c.TurnCount > 0 || !string.IsNullOrWhiteSpace(c.ConversationStatus)),
                "AI handled" => q.Where(c => !c.HumanOverrideActive),
                "Human required" => q.Where(c => c.HumanOverrideActive),
                _ => q
            };

            return q.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Refresh();

        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var phone = query["phone"];
        if (!string.IsNullOrWhiteSpace(phone))
        {
            var match = Customers.FirstOrDefault(c =>
                c.PhoneNumber == phone || c.PhoneNumber.EndsWith(phone.TrimStart('+')));
            if (match != null)
            {
                await Select(match);
            }
        }

        _timer = new Timer(async _ =>
        {
            await Refresh(quiet: true);
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(20), TimeSpan.FromSeconds(20));
    }

    private async Task Refresh(bool quiet = false)
    {
        try
        {
            Error = "";
            Customers = await Api.GetCustomers();
            Recent = await Api.GetRecentActivity();

            if (Selected != null)
            {
                Selected = Customers.FirstOrDefault(c => c.Id == Selected.Id) ?? Selected;
                Messages = await Api.GetMessages(Selected.PhoneNumber);
                Appointments = await Api.GetCustomerAppointments(Selected.PhoneNumber);
            }
        }
        catch
        {
            if (!quiet) Error = "load";
        }
    }

    private async Task Select(ReignApiClient.CustomerDto customer)
    {
        try
        {
            Error = "";
            Notice = "";
            Selected = customer;
            Messages = await Api.GetMessages(customer.PhoneNumber);
            Appointments = await Api.GetCustomerAppointments(customer.PhoneNumber);
        }
        catch
        {
            Error = "load";
        }
    }

    private async Task Send()
    {
        if (Selected == null || string.IsNullOrWhiteSpace(Draft)) return;

        Busy = true;
        try
        {
            Notice = await Api.SendOwnerSms(Selected.PhoneNumber, Draft.Trim());
            Draft = "";
            await ClearComposer();
            await Refresh(quiet: true);
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task AiAssist()
    {
        if (Selected == null) return;

        var lastInbound = Messages.LastOrDefault(m => m.Direction == "Inbound");
        if (lastInbound == null)
        {
            Notice = "No customer message to respond to yet.";
            return;
        }

        Busy = true;
        try
        {
            var result = await Api.AskOwnerAsync(
                $"Suggest a short, professional SMS reply I could send to {Fmt.DisplayName(Selected.Name, Selected.PhoneNumber)}. Their last message was: \"{lastInbound.Body}\"");
            if (!string.IsNullOrWhiteSpace(result.Error))
            {
                Notice = "REIGN couldn't draft a suggestion right now.";
            }
            else
            {
                Draft = result.Reply ?? "";
                Notice = "REIGN drafted a suggestion — review before sending.";
                await SetComposer(Draft);
            }
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task SetComposer(string value)
    {
        try
        {
            await Js.InvokeVoidAsync("reignUi.setValue", "composer", value);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private Task ClearComposer() => SetComposer("");

    private async Task ResumeAi()
    {
        if (Selected == null) return;
        await Api.ResumeAssistant(Selected.PhoneNumber);
        await Refresh(quiet: true);
    }

    private async Task Confirm(Guid id)
    {
        await Api.ConfirmAppointment(id);
        if (Selected != null)
        {
            Appointments = await Api.GetCustomerAppointments(Selected.PhoneNumber);
        }
    }

    private async Task Cancel(Guid id)
    {
        await Api.CancelAppointment(id);
        if (Selected != null)
        {
            Appointments = await Api.GetCustomerAppointments(Selected.PhoneNumber);
        }
    }

    public void Dispose() => _timer?.Dispose();
}
