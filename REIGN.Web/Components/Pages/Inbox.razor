@page "/inbox"

@using REIGN.Web.Services

@inject ReignApiClient Api


<h1>REIGN Inbox</h1>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}


<div class="row">

    <div class="col-md-4">

        <div class="card p-3">

            <h3>Customers</h3>

            <button class="btn btn-secondary mb-3"
                    @onclick="LoadCustomers">
                Refresh
            </button>


            @foreach (var customer in Customers)
            {
                <button class="btn btn-outline-primary mb-2 text-start w-100"
                        @onclick="() => SelectCustomer(customer)">

                    <strong>
                        @(string.IsNullOrWhiteSpace(customer.Name) ? customer.PhoneNumber : customer.Name)
                    </strong>

                    <br />

                    <small>
                        @customer.PhoneNumber<br />
                        Messages: @customer.Messages |
                        Appointments: @customer.Appointments
                        @if (!string.IsNullOrWhiteSpace(customer.CurrentIntent))
                        {
                            <span> | Intent: @customer.CurrentIntent</span>
                        }
                        @if (customer.HumanOverrideActive)
                        {
                            <span> | Owner speaking</span>
                        }
                    </small>

                </button>
            }

        </div>

    </div>



    <div class="col-md-8">

        @if (SelectedCustomer == null)
        {
            <div class="alert alert-info">
                Select a customer.
            </div>
        }
        else
        {

            <div class="card p-3">

                <h3>
                    Customer:
                    @(string.IsNullOrWhiteSpace(SelectedCustomer.Name) ? SelectedCustomer.PhoneNumber : SelectedCustomer.Name)
                    <small>@SelectedCustomer.PhoneNumber</small>
                </h3>

                @if (!string.IsNullOrWhiteSpace(SelectedCustomer.MemorySummary))
                {
                    <div class="alert alert-secondary">
                        @SelectedCustomer.MemorySummary
                    </div>
                }

                @if (SelectedCustomer.HumanOverrideActive)
                {
                    <div class="alert alert-warning">
                        Miss Reign auto-replies are paused. You are speaking as the owner from the REIGN business number.
                        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="ResumeAi">
                            Resume AI
                        </button>
                    </div>
                }


                <hr />

                <h4>Conversation</h4>


                <div>

                    @foreach (var message in Messages)
                    {
                        <div class="mb-2">

                            <strong>
                                @message.Direction:
                            </strong>

                            @message.Body

                            <br />

                            <small>
                                @message.CreatedAt
                            </small>

                        </div>
                    }

                </div>


                <hr />


                <textarea class="form-control"
                          @bind="Message">
                </textarea>


                <br />


                <button class="btn btn-primary"
                        @onclick="Send">
                    Send owner SMS
                </button>


                @if (!string.IsNullOrWhiteSpace(Response))
                {
                    <div class="alert alert-info mt-3">
                        @Response
                    </div>
                }


            </div>



            <div class="card p-3 mt-4">

                <h3>Appointments</h3>


                @foreach (var appointment in Appointments)
                {

                    <div class="border p-2 mb-2">

                        <strong>
                            @appointment.Service
                        </strong>


                        <br />

                        @appointment.AppointmentTime


                        <br />

                        Status:
                        @appointment.Status


                        <br />

                        Price:
                        @appointment.Price


                        <br />


                        @if (appointment.Status == "Pending")
                        {
                            <button class="btn btn-success"
                                    @onclick="() => Confirm(appointment.Id)">
                                Confirm
                            </button>
                        }


                        @if (appointment.Status != "Cancelled")
                        {
                            <button class="btn btn-danger ms-2"
                                    @onclick="() => Cancel(appointment.Id)">
                                Cancel
                            </button>
                        }

                    </div>

                }

            </div>

        }

    </div>

</div>



@code {

    List<ReignApiClient.CustomerDto> Customers = new();

    ReignApiClient.CustomerDto? SelectedCustomer;

    List<ReignApiClient.MessageDto> Messages = new();

    List<ReignApiClient.AppointmentDto> Appointments = new();


    string Message = "";

    string Response = "";

    string Error = "";



    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }



    async Task LoadCustomers()
    {
        try
        {
            Error = "";
            Customers = await Api.GetCustomers();
        }
        catch (Exception ex)
        {
            Error = "Inbox could not load customers. " + ex.Message;
        }
    }



    async Task SelectCustomer(
        ReignApiClient.CustomerDto customer)
    {
        try
        {
            Error = "";
            SelectedCustomer = customer;
            Messages = await Api.GetMessages(customer.PhoneNumber);
            Appointments = await Api.GetCustomerAppointments(customer.PhoneNumber);
        }
        catch (Exception ex)
        {
            Error = "Could not load this conversation. " + ex.Message;
        }
    }



    async Task Send()
    {
        if (SelectedCustomer == null)
            return;


        if (string.IsNullOrWhiteSpace(Message))
            return;


        var selectedId = SelectedCustomer.Id;
        var phone = SelectedCustomer.PhoneNumber;

        Response =
            await Api.SendOwnerSms(
                phone,
                Message);


        Message = "";


        await LoadCustomers();
        SelectedCustomer = Customers.FirstOrDefault(c => c.Id == selectedId) ?? SelectedCustomer;

        Messages =
            await Api.GetMessages(
                phone);


        Appointments =
            await Api.GetCustomerAppointments(
                phone);

    }



    async Task ResumeAi()
    {
        if (SelectedCustomer == null)
            return;

        await Api.ResumeAssistant(SelectedCustomer.PhoneNumber);
        await LoadCustomers();
        SelectedCustomer = Customers.FirstOrDefault(c => c.Id == SelectedCustomer.Id) ?? SelectedCustomer;
    }

    async Task Confirm(Guid id)
    {
        await Api.ConfirmAppointment(id);

        if (SelectedCustomer != null)
        {
            Appointments =
                await Api.GetCustomerAppointments(
                    SelectedCustomer.PhoneNumber);
        }
    }



    async Task Cancel(Guid id)
    {
        await Api.CancelAppointment(id);

        if (SelectedCustomer != null)
        {
            Appointments =
                await Api.GetCustomerAppointments(
                    SelectedCustomer.PhoneNumber);
        }
    }

}