@page "/system"

@implements IDisposable
@inject ReignApiClient Api

<PageTitle>System Health — REIGN AI</PageTitle>

<div class="page-head row-flex">
    <div class="grow">
        <h1>System Health</h1>
        <p>Live status of everything REIGN depends on.</p>
    </div>
    <button class="btn btn-ghost" @onclick="() => Load()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.6-6.3M21 3v6h-6"/></svg>
        Refresh
    </button>
</div>

@if (Loading)
{
    <div class="loading"><span class="spinner"></span> Checking system health…</div>
}
else
{
    <div style="max-width:760px;">
        <div class="health-row">
            <span class="health-icon @(Health != null ? "ok" : "bad")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            </span>
            <div>
                <div class="health-name">API</div>
                <div class="health-detail">The REIGN service</div>
            </div>
            <span class="health-status">
                <StatusBadge Text="@(Health == null ? "Offline" : Health.Status == "healthy" ? "Healthy" : "Degraded")"
                             Kind="@(Health == null ? "danger" : Health.Status == "healthy" ? "success" : "warning")" />
            </span>
        </div>

        <div class="health-row">
            <span class="health-icon @(DatabaseOk ? "ok" : "bad")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg>
            </span>
            <div>
                <div class="health-name">Database</div>
                <div class="health-detail">Customers, conversations, appointments</div>
            </div>
            <span class="health-status">
                <StatusBadge Text="@(Health?.Database == "connected" ? "Connected" : "Disconnected")"
                             Kind="@(DatabaseOk ? "success" : "danger")" />
            </span>
        </div>

        <div class="health-row">
            <span class="health-icon @(Health?.GroqConfigured == true ? "ok" : "warn")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a7 7 0 0 1 7 7c0 2.4-1.2 4-2.6 5.4-.9.9-1.4 1.6-1.4 2.6h-6c0-1-.5-1.7-1.4-2.6C6.2 13 5 11.4 5 9a7 7 0 0 1 7-7Z"/><path d="M9 21h6"/></svg>
            </span>
            <div>
                <div class="health-name">AI</div>
                <div class="health-detail">@(AiStatus == null ? "Conversation intelligence" : $"Provider: {AiStatus.Provider} · Model: {AiStatus.Model}")</div>
            </div>
            <span class="health-status">
                <StatusBadge Text="@(Health?.GroqConfigured == true ? "Configured" : "Not configured")"
                             Kind="@(Health?.GroqConfigured == true ? "success" : "warning")" />
            </span>
        </div>

        <div class="health-row">
            <span class="health-icon @(Health?.SmsConfigured == true ? "ok" : "warn")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.5 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
            </span>
            <div>
                <div class="health-name">SMS</div>
                <div class="health-detail">@(Integrations == null ? "Customer messaging" : $"Provider: {Integrations.Sms.ActiveProvider}")</div>
            </div>
            <span class="health-status">
                <StatusBadge Text="@(Health?.SmsConfigured == true ? "Configured" : "Not configured")"
                             Kind="@(Health?.SmsConfigured == true ? "success" : "warning")" />
            </span>
        </div>

        <div class="health-row">
            <span class="health-icon @(Health?.CalendarConfigured == true ? "ok" : "warn")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4m8-4v4"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/></svg>
            </span>
            <div>
                <div class="health-name">Calendar</div>
                <div class="health-detail">@(Integrations == null ? "Appointment booking" : $"Provider: {Integrations.GoogleCalendar.ActiveProvider}")</div>
            </div>
            <span class="health-status">
                <StatusBadge Text="@(Health?.CalendarConfigured == true ? "Configured" : "Not configured")"
                             Kind="@(Health?.CalendarConfigured == true ? "success" : "warning")" />
            </span>
        </div>

        <p class="small faint mt-2">Checked @Fmt.TimeAgo(CheckedAt) · auto-refreshes every 30 seconds</p>
    </div>
}

@code {
    private bool Loading = true;
    private ReignApiClient.HealthDto? Health;
    private ReignApiClient.AiStatusDto? AiStatus;
    private ReignApiClient.IntegrationStatusDto? Integrations;
    private DateTime CheckedAt = DateTime.UtcNow;
    private Timer? _timer;

    private bool DatabaseOk => Health?.Database == "connected";

    protected override async Task OnInitializedAsync()
    {
        await Load();
        _timer = new Timer(async _ =>
        {
            await Load(quiet: true);
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task Load(bool quiet = false)
    {
        if (!quiet) Loading = true;
        Health = await Api.GetHealth();
        AiStatus = await Api.GetAiStatus();
        Integrations = await Api.GetIntegrationStatus();
        CheckedAt = DateTime.UtcNow;
        Loading = false;
    }

    public void Dispose() => _timer?.Dispose();
}
