@page "/calendar"

@inject ReignApiClient Api

<PageTitle>Calendar — REIGN AI</PageTitle>

<div class="page-head">
    <h1>Jessica's schedule</h1>
    <p>Confirmed customer texts land on Jessica's Google Calendar so she can show up and provide the visit.</p>
</div>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="error-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
        <span class="msg">@Error</span>
        <button class="btn btn-ghost btn-sm" @onclick="Load">Try again</button>
    </div>
}

<div class="card mb-2 row-flex">
    <span class="health-icon @(GoogleConnected ? "ok" : "warn")" style="width:42px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4m8-4v4"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/></svg>
    </span>
    <div class="grow">
        <div class="health-name">Google Calendar</div>
        <div class="health-detail">
            @(Status == null ? "Checking connection…"
                : GoogleConnected
                    ? $"Connected to Jessica's calendar · {CalendarTarget}"
                    : $"Not connected — Jessica signs in as {CalendarTarget} so booked visits show on her schedule")
        </div>
    </div>
    @if (Status != null)
    {
        <a class="btn btn-primary btn-sm" href="@AuthorizeUrl">@(GoogleConnected ? "Reconnect Google Calendar" : "Connect Google Calendar")</a>
    }
</div>

@if (Status != null && !string.IsNullOrWhiteSpace(Status.GoogleCalendar.RedirectUri) && Status.GoogleCalendar.RedirectUri.Contains("localhost", StringComparison.OrdinalIgnoreCase))
{
    <div class="error-state mb-2">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
        <span class="msg">Google OAuth is still using a localhost callback, so production consent cannot complete. Set GOOGLE_REDIRECT_URI to the public API callback, or redeploy the production redirect fix.</span>
    </div>
}

<div class="card mb-2">
    <div class="card-title">Book an appointment</div>
    <div class="card-sub">Creates the visit on Jessica's calendar when you confirm.</div>
    <div class="grid grid-2 mt-1">
        <div>
            <label class="field-label" for="booking-phone">Customer phone</label>
            <input id="booking-phone" class="input" @bind="BookPhone" placeholder="+1…" />
        </div>
        <div>
            <label class="field-label" for="booking-name">Customer name</label>
            <input id="booking-name" class="input" @bind="BookName" placeholder="Optional" />
        </div>
        <div>
            <label class="field-label" for="booking-service">Service</label>
            <select id="booking-service" class="input" @bind="BookService">
                @if (Catalog?.Services.Count > 0)
                {
                    @foreach (var service in Catalog.Services)
                    {
                        <option value="@service.Name">@service.Code - @Fmt.Money(service.Price) - @service.DurationMinutes minutes</option>
                    }
                }
                else
                {
                    <option value="Quick Visit">QV - $150 - Less than 30 minutes</option>
                    <option value="Half Hour">HH - $300 - 30 minutes</option>
                    <option value="Hour">HR - $500 - 60 minutes</option>
                }
            </select>
        </div>
        <div>
            <label class="field-label" for="booking-time">Time (@TimeZoneLabel)</label>
            <input id="booking-time" class="input" type="datetime-local" @bind="BookTime" @bind:format="yyyy-MM-ddTHH:mm" />
        </div>
    </div>
    <label class="row-flex mt-1" style="gap:8px;">
        <input type="checkbox" @bind="BookConfirm" />
        <span class="small">Confirm now (adds to Jessica's Google Calendar when connected)</span>
    </label>
    <div class="mt-1">
        <button class="btn btn-primary" @onclick="Book" disabled="@Busy">Book Appointment</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Notice))
    {
        <p class="small mt-1" style="margin-bottom:0;color:var(--success);">@Notice</p>
    }
</div>

@if (Loading)
{
    <div class="loading"><span class="spinner"></span> Loading appointments…</div>
}
else if (Appointments.Count == 0)
{
    <div class="card">
        <EmptyState Title="No appointments yet"
                    Description="@($"Book from this page or wait for a customer to text {ReignContact.BusinessPhoneDisplay}.")"
                    Icon="M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table table-cards">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Service</th>
                    <th>Time</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Jessica's calendar</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Appointments)
                {
                    <tr>
                        <td data-label="Customer">
                            <span class="cell-main">@a.Customer</span>
                            @if (!string.IsNullOrWhiteSpace(a.Phone))
                            {
                                <div class="small faint">@a.Phone</div>
                            }
                        </td>
                        <td data-label="Service">@a.Service</td>
                        <td data-label="Time">@Fmt.AppointmentTime(a.AppointmentTime)</td>
                        <td data-label="Price">@Fmt.Money(a.Price)</td>
                        <td data-label="Status">
                            <StatusBadge Text="@a.Status" Kind="@StatusBadge.KindForAppointment(a.Status)" />
                        </td>
                        <td data-label="Jessica's calendar">
                            @if (!string.IsNullOrWhiteSpace(a.ExternalCalendarEventId))
                            {
                                <StatusBadge Text="On Google" Kind="success" />
                            }
                            else if (a.Status == "Confirmed")
                            {
                                <StatusBadge Text="Not on Google yet" Kind="warning" />
                            }
                            else if (a.Status == "Pending")
                            {
                                <StatusBadge Text="Waiting for YES" Kind="info" />
                            }
                            else
                            {
                                <span class="small faint">—</span>
                            }
                        </td>
                        <td>
                            @if (a.Status != "Cancelled")
                            {
                                <div class="row-flex" style="flex-wrap:wrap;">
                                    @if (a.Status != "Confirmed")
                                    {
                                        <button class="btn btn-success btn-sm" @onclick="() => Confirm(a.Id)">Confirm</button>
                                    }
                                    <button class="btn btn-ghost btn-sm" @onclick="() => ToggleReschedule(a.Id)">Reschedule</button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => Cancel(a.Id)">Cancel</button>
                                </div>
                                @if (RescheduleId == a.Id)
                                {
                                    <div class="row-flex mt-1">
                                        <input class="input" type="datetime-local" @bind="RescheduleTime" @bind:format="yyyy-MM-ddTHH:mm" />
                                        <button class="btn btn-primary btn-sm" @onclick="() => Reschedule(a.Id)" disabled="@Busy">Save</button>
                                    </div>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool Loading = true;
    private bool Busy;
    private string Error = "";
    private string Notice = "";
    private List<ReignApiClient.AppointmentDto> Appointments = new();
    private ReignApiClient.IntegrationStatusDto? Status;
    private ReignApiClient.CatalogDto? Catalog;
    private string? TimeZoneId;

    private string BookPhone = "";
    private string BookName = "";
    private string BookService = "Quick Visit";
    private DateTime BookTime = DateTime.Now.Date.AddDays(1).AddHours(10);
    private bool BookConfirm = true;
    private Guid? RescheduleId;
    private DateTime RescheduleTime = DateTime.Now.Date.AddDays(1).AddHours(10);

    private bool GoogleConnected =>
        Status != null && !Status.GoogleCalendar.Simulated && Status.GoogleCalendar.HasStoredGrant;

    private string AuthorizeUrl => $"{Api.BaseAddress}api/integrations/google/authorize";

    private string TimeZoneLabel => string.IsNullOrWhiteSpace(TimeZoneId) ? "Pacific" : TimeZoneId.Replace('_', ' ');

    private string CalendarTarget =>
        ReignContact.CalendarAccountForDisplay(
            !string.IsNullOrWhiteSpace(Status?.GoogleCalendar.ExpectedAccount)
                ? Status!.GoogleCalendar.ExpectedAccount
                : Status?.GoogleCalendar.CalendarId);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        Loading = true;
        Error = "";
        try
        {
            Appointments = await Api.GetAppointments();
            Status = await Api.GetIntegrationStatus();
            Catalog = await Api.GetCatalog();
            TimeZoneId = (await Api.GetBusinesses()).FirstOrDefault()?.TimeZone;
            if (Catalog?.Services.Count > 0 && string.IsNullOrWhiteSpace(BookService))
            {
                BookService = Catalog.Services[0].Name;
            }
        }
        catch
        {
            Error = "Something went wrong. REIGN couldn't load appointments.";
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task Book()
    {
        Notice = "";
        Error = "";
        if (string.IsNullOrWhiteSpace(BookPhone) || BookTime == default)
        {
            Error = "Phone and time are required to book.";
            return;
        }

        Busy = true;
        try
        {
            var result = await Api.CreateAppointment(BookPhone.Trim(), BookService, BookTime, BookName, BookConfirm);
            if (!string.IsNullOrWhiteSpace(result?.Error))
            {
                Error = result.Error;
                return;
            }

            if (result?.CalendarSynced == true)
            {
                Notice = "Booked. Jessica can see this on her Google Calendar.";
                BookPhone = "";
                BookName = "";
                await Load();
            }
            else
            {
                Notice = result?.Message ?? "Appointment booked.";
                var calendarError = result?.CalendarSyncError;
                BookPhone = "";
                BookName = "";
                await Load();
                if (!string.IsNullOrWhiteSpace(calendarError))
                {
                    Error = $"Jessica's Google Calendar did not update: {calendarError}";
                }
            }
        }
        finally
        {
            Busy = false;
        }
    }

    private void ToggleReschedule(Guid id)
    {
        if (RescheduleId == id)
        {
            RescheduleId = null;
            return;
        }

        var current = Appointments.FirstOrDefault(a => a.Id == id);
        RescheduleId = id;
        RescheduleTime = current?.AppointmentTime ?? DateTime.Now.Date.AddDays(1).AddHours(10);
    }

    private async Task Reschedule(Guid id)
    {
        Busy = true;
        Error = "";
        try
        {
            var result = await Api.RescheduleAppointment(id, RescheduleTime);
            if (!string.IsNullOrWhiteSpace(result?.Error))
            {
                Error = result.Error;
                return;
            }

            RescheduleId = null;
            Notice = result?.Message ?? "Appointment updated.";
            await Load();
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task Confirm(Guid id)
    {
        await Api.ConfirmAppointment(id);
        await Load();
    }

    private async Task Cancel(Guid id)
    {
        await Api.CancelAppointment(id);
        await Load();
    }
}
