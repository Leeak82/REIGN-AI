@page "/reign"

@using REIGN.Web.Services
@inject ReignApiClient ReignClient

<h1>Miss Reign AI</h1>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}

<div class="mb-2">
    <input class="form-control" @bind="Phone" placeholder="Phone Number" />
</div>

<div class="mb-2">
    <textarea class="form-control" @bind="Message" placeholder="Type a message"></textarea>
</div>

<button class="btn btn-primary" @onclick="Send" disabled="@Busy">
    Send
</button>

@if (!string.IsNullOrWhiteSpace(Reply))
{
    <hr />
    <h3>Miss Reign:</h3>
    <p>@Reply</p>
    @if (!string.IsNullOrWhiteSpace(Intent))
    {
        <small>Intent: @Intent@(Persisted ? " · saved" : "")</small>
    }
}

@code {
    private string Phone = "3605550100";
    private string Message = "";
    private string Reply = "";
    private string Intent = "";
    private bool Persisted;
    private string Error = "";
    private bool Busy;

    private async Task Send()
    {
        Error = "";
        if (string.IsNullOrWhiteSpace(Phone) || string.IsNullOrWhiteSpace(Message))
        {
            Error = "Phone and message are required.";
            return;
        }

        Busy = true;
        try
        {
            var result = await ReignClient.ChatAsync(Phone, Message);
            if (!string.IsNullOrWhiteSpace(result.Error))
            {
                Error = result.Error;
                return;
            }

            Reply = result.Reply ?? "No response.";
            Intent = result.Intent ?? "";
            Persisted = result.Persisted;
            Message = "";
        }
        finally
        {
            Busy = false;
        }
    }
}
