@page "/customers/{Phone}"

@inject ReignApiClient Api
@inject CustomerAdminClient Admin
@inject NavigationManager Nav

<PageTitle>@(Profile == null ? "Customer" : Fmt.DisplayName(Profile.Name, Profile.PhoneNumber)) — REIGN AI</PageTitle>

@if (!string.IsNullOrWhiteSpace(Notice))
{
    <div class="card mb-2">
        <strong>@Notice</strong>
    </div>
}

@if (Loading)
{
    <div class="loading"><span class="spinner"></span> Loading customer…</div>
}
else if (Profile == null)
{
    <div class="page-head">
        <h1>Customer not found</h1>
        <p>REIGN has no record of this customer.</p>
    </div>
    <div class="card">
        <EmptyState Title="No customer found"
                    Description="This customer may not have texted your REIGN number yet."
                    Icon="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
        <div style="text-align:center;"><a class="btn btn-ghost" href="customers">Back to customers</a></div>
    </div>
}
else
{
    <div class="page-head row-flex">
        <span class="avatar gradient" style="width:52px;height:52px;font-size:18px;">@Fmt.Initials(Profile.Name, Profile.PhoneNumber)</span>
        <div class="grow">
            <h1>@Fmt.DisplayName(Profile.Name, Profile.PhoneNumber)</h1>
            <p>@Profile.PhoneNumber</p>
        </div>
        @if (Profile.HumanOverrideActive)
        {
            <StatusBadge Text="Human required" Kind="warning" />
        }
        else
        {
            <StatusBadge Text="AI handling" Kind="accent" />
        }
        <a class="btn btn-primary" href="inbox?phone=@Uri.EscapeDataString(Profile.PhoneNumber)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>
            Open conversation
        </a>
    </div>

    <div class="grid" style="grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items:start;">
        <div>
            <div class="card" style="padding:0;">
                <div class="panel-section">
                    <div class="row-flex" style="justify-content:space-between; align-items:center;">
                        <h4 style="margin:0;">Contact</h4>
                        @if (!Editing)
                        {
                            <button class="btn btn-ghost btn-sm" @onclick="BeginEdit">Edit contact</button>
                        }
                    </div>

                    @if (!Editing)
                    {
                        <div class="kv"><span class="k">Name</span><span class="v">@(Profile.Name ?? "—")</span></div>
                        <div class="kv"><span class="k">Phone</span><span class="v">@Profile.PhoneNumber</span></div>
                        <div class="kv"><span class="k">Notes</span><span class="v">@(string.IsNullOrWhiteSpace(Profile.Notes) ? "—" : Profile.Notes)</span></div>
                    }
                    else
                    {
                        <label style="display:block; margin-top:12px;">
                            <span class="dim">Name</span>
                            <input class="input" @bind="EditName" />
                        </label>
                        <label style="display:block; margin-top:10px;">
                            <span class="dim">Phone</span>
                            <input class="input" @bind="EditPhone" />
                        </label>
                        <label style="display:block; margin-top:10px;">
                            <span class="dim">Notes</span>
                            <textarea class="input" style="min-height:90px; resize:vertical;" @bind="EditNotes"></textarea>
                        </label>
                        <div class="row-flex" style="gap:8px; margin-top:12px; justify-content:flex-end;">
                            <button class="btn btn-ghost" @onclick="CancelEdit" disabled="@Saving">Cancel</button>
                            <button class="btn btn-primary" @onclick="SaveContact" disabled="@Saving">@(Saving ? "Saving…" : "Save changes")</button>
                        </div>
                    }
                </div>
                <div class="panel-section">
                    <h4>REIGN</h4>
                    <div class="kv"><span class="k">Current intent</span><span class="v">@(string.IsNullOrWhiteSpace(Profile.CurrentIntent) ? "—" : Fmt.Label(Profile.CurrentIntent))</span></div>
                    <div class="kv"><span class="k">Pending service</span><span class="v">@(Profile.PendingServiceName ?? "—")</span></div>
                    <div class="kv"><span class="k">Conversation</span><span class="v">@(Profile.ConversationStatus ?? "—")</span></div>
                    <div class="kv"><span class="k">Turns</span><span class="v">@Profile.TurnCount</span></div>
                    @if (Profile.LastCustomerMessageAt != null)
                    {
                        <div class="kv"><span class="k">Last heard</span><span class="v">@Fmt.TimeAgo(Profile.LastCustomerMessageAt.Value)</span></div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Profile.MemorySummary))
                {
                    <div class="panel-section">
                        <h4>What REIGN remembers</h4>
                        <p class="small dim" style="margin:0;white-space:pre-wrap;">@Profile.MemorySummary</p>
                    </div>
                }
            </div>

            <div class="card mt-2" style="padding:0;">
                <div class="panel-section">
                    <h4>Appointments</h4>
                    @if (Profile.Appointments.Count == 0)
                    {
                        <p class="small faint" style="margin:0;">No appointments yet.</p>
                    }
                    @foreach (var a in Profile.Appointments)
                    {
                        <div class="kv">
                            <span class="k">@a.Service<br /><span class="small faint">@Fmt.AppointmentTime(a.AppointmentTime)</span></span>
                            <span class="v"><StatusBadge Text="@a.Status" Kind="@StatusBadge.KindForAppointment(a.Status)" /></span>
                        </div>
                    }
                </div>
            </div>

            <div class="card mt-2">
                <div class="card-title">Customer record</div>
                <p class="small dim" style="margin:4px 0 12px;">
                    Use this for test/fake customers or records that should no longer exist. This action does not send a text.
                </p>
                @if (!ConfirmDelete)
                {
                    <button class="btn btn-ghost" @onclick="StartDelete">Delete customer…</button>
                }
                else
                {
                    <div class="small" style="margin-bottom:10px;">
                        Type the customer's current phone number to confirm. Conversation history will be deleted.
                    </div>
                    <input class="input" @bind="DeleteConfirmPhone" placeholder="Confirm current phone number" />
                    @if (Profile.Appointments.Count > 0)
                    {
                        <label class="row-flex" style="gap:8px; margin-top:10px; align-items:flex-start;">
                            <input type="checkbox" @bind="DeleteAppointments" />
                            <span class="small">Cancel and remove this customer's appointments too. REIGN will cancel any linked Google Calendar event before deleting the appointment record.</span>
                        </label>
                    }
                    <div class="row-flex" style="gap:8px; margin-top:12px; flex-wrap:wrap;">
                        <button class="btn btn-ghost" @onclick="CancelDelete" disabled="@Deleting">Keep customer</button>
                        <button class="btn" @onclick="DeleteCustomer" disabled="@Deleting">@(Deleting ? "Deleting…" : "Delete permanently")</button>
                    </div>
                }
            </div>
        </div>

        <div class="card" style="padding:0;">
            <div class="ws-col-head">
                <div class="card-title">Conversation history</div>
                <div class="card-sub" style="margin:2px 0 0;">Every message REIGN has with this customer</div>
            </div>
            <div class="chat-scroll" style="max-height:70vh;">
                @if (Profile.Messages.Count == 0)
                {
                    <EmptyState Title="No messages yet"
                                Description="The conversation history appears here after the first text." />
                }
                @foreach (var m in Profile.Messages)
                {
                    var outbound = m.Direction == "Outbound";
                    <div class="bubble-row @(outbound ? "out" : "in")">
                        <span class="bubble-tag">@(outbound ? (m.IsOwnerOverride ? "OWNER" : "REIGN") : "CUSTOMER")</span>
                        <div class="bubble">@m.Body</div>
                        <span class="bubble-time">@Fmt.TimeAgo(m.CreatedAt)</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Phone { get; set; } = "";

    private bool Loading = true;
    private bool Editing;
    private bool Saving;
    private bool ConfirmDelete;
    private bool Deleting;
    private bool DeleteAppointments;
    private string DeleteConfirmPhone = "";
    private string EditPhone = "";
    private string? EditName;
    private string? EditNotes;
    private string? Notice;
    private ReignApiClient.CustomerProfileDto? Profile;

    protected override async Task OnParametersSetAsync()
    {
        await LoadProfile(Phone);
    }

    private async Task LoadProfile(string phone)
    {
        Loading = true;
        Profile = await Api.GetCustomerProfile(phone);
        Loading = false;
    }

    private void BeginEdit()
    {
        if (Profile == null)
        {
            return;
        }

        EditName = Profile.Name;
        EditPhone = Profile.PhoneNumber;
        EditNotes = Profile.Notes;
        Editing = true;
        Notice = null;
    }

    private void CancelEdit()
    {
        Editing = false;
        Notice = null;
    }

    private async Task SaveContact()
    {
        if (Profile == null)
        {
            return;
        }

        Saving = true;
        Notice = null;
        try
        {
            var oldPhone = Profile.PhoneNumber;
            var result = await Admin.UpdateAsync(new CustomerAdminDto
            {
                Id = Profile.Id,
                PhoneNumber = EditPhone,
                Name = EditName,
                Notes = EditNotes
            });

            if (!string.IsNullOrWhiteSpace(result.Error) || result.Customer == null)
            {
                Notice = result.Error ?? "REIGN could not save that customer.";
                return;
            }

            Editing = false;
            Notice = "Customer contact information saved.";
            var newPhone = result.Customer.PhoneNumber;
            if (!string.Equals(oldPhone, newPhone, StringComparison.Ordinal))
            {
                Nav.NavigateTo($"customers/{Uri.EscapeDataString(newPhone)}", replace: true);
                return;
            }

            await LoadProfile(newPhone);
        }
        catch (Exception ex)
        {
            Notice = ex.Message;
        }
        finally
        {
            Saving = false;
        }
    }

    private void StartDelete()
    {
        ConfirmDelete = true;
        DeleteConfirmPhone = "";
        DeleteAppointments = false;
        Notice = null;
    }

    private void CancelDelete()
    {
        ConfirmDelete = false;
        DeleteConfirmPhone = "";
        DeleteAppointments = false;
        Notice = null;
    }

    private async Task DeleteCustomer()
    {
        if (Profile == null)
        {
            return;
        }

        Deleting = true;
        Notice = null;
        try
        {
            var result = await Admin.DeleteAsync(Profile.Id, DeleteConfirmPhone, DeleteAppointments);
            if (!result.Deleted)
            {
                Notice = result.Error ?? "REIGN did not delete the customer.";
                return;
            }

            Nav.NavigateTo("customers", replace: true);
        }
        catch (Exception ex)
        {
            Notice = ex.Message;
        }
        finally
        {
            Deleting = false;
        }
    }
}
