@page "/dashboard"

@using REIGN.Web.Services
@inject ReignApiClient Api

<h3>REIGN Service Advisor Dashboard</h3>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}

<div style="display:flex;gap:20px">
    <div style="border:1px solid #ccc;padding:20px">
        <h4>Customers</h4>
        <h2>@CustomerCount</h2>
    </div>
    <div style="border:1px solid #ccc;padding:20px">
        <h4>Appointments</h4>
        <h2>@Appointments.Count</h2>
    </div>
    <div style="border:1px solid #ccc;padding:20px">
        <h4>Messages</h4>
        <h2>@MessageCount</h2>
    </div>
</div>

<h3>Today's Appointments</h3>

@if (!Appointments.Any())
{
    <div class="alert alert-info">No appointments loaded.</div>
}

@foreach (var a in VisibleAppointments)
{
    <div style="border:1px solid #ddd;padding:10px;margin:10px">
        <b>@a.Service</b>
        <br />
        @a.Customer
        <br />
        @a.AppointmentTime
        <br />
        Status: @a.Status
    </div>
}

@code {
    string Error = "";
    int CustomerCount;
    int MessageCount;
    List<ReignApiClient.AppointmentDto> Appointments = new();
    List<ReignApiClient.AppointmentDto> VisibleAppointments =>
        Appointments.Where(x => x.AppointmentTime.Date == DateTime.Today).ToList() is { Count: > 0 } today
            ? today
            : Appointments.Take(8).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var customers = await Api.GetCustomers();
            CustomerCount = customers.Count;
            MessageCount = customers.Sum(c => c.Messages);
            Appointments = await Api.GetAppointments();
        }
        catch (Exception ex)
        {
            Error = "Dashboard could not load from the REIGN API. " + ex.Message;
        }
    }
}
