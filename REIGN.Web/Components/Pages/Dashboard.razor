@using REIGN.Web.Models
@page "/dashboard"

@using REIGN.Web.Services
@inject ReignApiClient ReignClient

<h1>Dashboard</h1>

<section class="card p-4 mb-4">
    <h2>Appointments</h2>

    @if (Appointments == null)
    {
        <div class="alert alert-info">Loading...</div>
    }
    else if (Appointments.Count == 0)
    {
        <div class="alert alert-warning">No upcoming appointments.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Phone</th>
                        <th>Service</th>
                        <th>Date/Time</th>
                        <th>Status</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Appointments)
                    {
                        <tr>
                            <td>@a.Customer</td>
                            <td>@a.Phone</td>
                            <td>@a.Service</td>
                            <td>@a.AppointmentTime.ToString("MMM d, yyyy h:mm tt")</td>
                            <td>
                                <span class="badge @(GetStatusBadge(a.Status))">@a.Status</span>
                            </td>
                            <td>$@a.Price.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card p-4">
    <h2>Activity Feed</h2>

    @if (Activity == null)
    {
        <div class="alert alert-info">Loading...</div>
    }
    else if (Activity.Count == 0)
    {
        <div class="alert alert-warning">No recent activity.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var item in Activity)
            {
                <div class="list-group-item">
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1">@item.Timestamp.ToString("MMM d, h:mm tt")</h6>
                        <small>@item.Type</small>
                    </div>
                    <p class="mb-1">@item.Description</p>
                    <small>By: @item.User</small>
                </div>
            }
        </div>
    }
</section>

@code {
    private List<ReignApiClient.AppointmentDto>? Appointments;
    private List<ActivityItem>? Activity;

    protected override async Task OnInitializedAsync()
    {
        Appointments = await ReignClient.GetAppointments();
        // Load activity after appointments are loaded
        Activity = await GetActivity();
    }

    private async Task<List<ActivityItem>> GetActivity()
    {
        var items = new List<ActivityItem>();

        // Recent appointments
        var recent = Appointments?
            .Where(a => a.Status == "Confirmed" || a.Status == "Pending")
            .OrderByDescending(a => a.AppointmentTime)
            .Take(5)
            .ToList();

        foreach (var a in recent)
        {
            items.Add(new ActivityItem
            {
                Timestamp = a.AppointmentTime,
                Type = "Appointment",
                Description = $"Appointment {@a.Service} for {@a.Customer}",
                User = "System"
            });
        }

        return items;
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Confirmed" => "bg-success",
        "Pending" => "bg-warning",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}