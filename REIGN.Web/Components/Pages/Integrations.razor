@page "/integrations"

@inject ReignApiClient Api
@inject IWebHostEnvironment HostEnvironment

<PageTitle>Integrations — REIGN AI</PageTitle>

<div class="page-head">
    <h1>Integrations</h1>
    <p>The services REIGN connects to on your behalf.</p>
</div>

@if (Loading)
{
    <div class="loading"><span class="spinner"></span> Loading integrations…</div>
}
else if (Status == null)
{
    <div class="error-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
        <span class="msg">Something went wrong. REIGN couldn't load integrations.</span>
        <button class="btn btn-ghost btn-sm" @onclick="Load">Try again</button>
    </div>
}
else
{
    <div class="grid grid-2" style="align-items:start;">
        <div class="card">
            <div class="row-flex">
                <span class="health-icon @(SmsLive ? "ok" : "warn")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.5 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
                </span>
                <div class="grow">
                    <div class="health-name">SMS</div>
                    <div class="health-detail">Customer messaging</div>
                </div>
                <StatusBadge Text="@(SmsLive ? "Live" : Status.Sms.Simulated ? "Simulated" : "Not configured")"
                             Kind="@(SmsLive ? "success" : "warning")" />
            </div>
            <div class="divider"></div>
            <div class="kv"><span class="k">Active provider</span><span class="v">@Status.Sms.ActiveProvider</span></div>
            <div class="kv"><span class="k">Configured provider</span><span class="v">@Status.Sms.ConfiguredProvider</span></div>
            <div class="kv"><span class="k">Credentials</span><span class="v">@(Status.Sms.CredentialsPresent ? "Present" : "Missing")</span></div>
            <div class="kv"><span class="k">Business number</span><span class="v">@(Status.Sms.BusinessPhoneConfigured ? (Status.Sms.BusinessPhoneDisplay ?? Status.Sms.BusinessPhoneNumber) : "Not configured")</span></div>
            <p class="small faint mt-1" style="margin-bottom:0;">
                Customer SMS runs through the configured provider on a dedicated REIGN business number.
                Provider and credentials are set in API configuration.
            </p>
            <a class="btn btn-ghost btn-sm mt-1" href="sms">SMS details</a>
        </div>

        <div class="card">
            <div class="row-flex">
                <span class="health-icon @(CalendarConnected ? "ok" : "warn")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4m8-4v4"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/></svg>
                </span>
                <div class="grow">
                    <div class="health-name">Google Calendar</div>
                    <div class="health-detail">Appointment booking</div>
                </div>
                <StatusBadge Text="@(CalendarConnected ? "Connected" : "Not connected")"
                             Kind="@(CalendarConnected ? "success" : "warning")" />
            </div>
            <div class="divider"></div>
            <div class="kv"><span class="k">Active provider</span><span class="v">@Status.GoogleCalendar.ActiveProvider</span></div>
            <div class="kv"><span class="k">OAuth client</span><span class="v">@(Status.GoogleCalendar.OauthClientConfigured ? "Configured" : "Not configured")</span></div>
            <div class="kv"><span class="k">Google account</span><span class="v">@(Status.GoogleCalendar.HasStoredGrant ? "Connected" : "Not connected")</span></div>
            <div class="kv"><span class="k">Calendar ID</span><span class="v">@(Status.GoogleCalendar.CalendarId ?? "primary")</span></div>
            @if (!string.IsNullOrWhiteSpace(Status.GoogleCalendar.ExpectedAccount))
            {
                <div class="kv"><span class="k">Sign in as</span><span class="v">@Status.GoogleCalendar.ExpectedAccount</span></div>
            }
            @if (Status.GoogleCalendar.Simulated)
            {
                <div class="kv"><span class="k">Mode</span><span class="v"><StatusBadge Text="Simulated" Kind="info" /></span></div>
            }
            <p class="small faint mt-1" style="margin-bottom:0;">
                Click Connect while signed into Google as <strong>@(Status.GoogleCalendar.ExpectedAccount ?? "j.collins2491@gmail.com")</strong>.
                That grants REIGN permission to view, create, and change events on that calendar.
            </p>
            <a class="btn btn-primary btn-sm mt-1" href="@AuthorizeUrl">@(CalendarConnected ? "Reconnect Google Calendar" : "Connect Google Calendar")</a>
        </div>
    </div>

    @if (HostEnvironment.IsDevelopment())
    {
        <div class="card mt-2">
            <div class="card-title">Development note</div>
            <p class="small dim" style="margin:6px 0 0;">
                Local development uses simulated providers until credentials are supplied in API configuration.
            </p>
        </div>
    }
}

@code {
    private bool Loading = true;
    private ReignApiClient.IntegrationStatusDto? Status;

    private bool SmsLive => Status != null && Status.Sms.CredentialsPresent && !Status.Sms.Simulated;
    private bool CalendarConnected =>
        Status != null && !Status.GoogleCalendar.Simulated && Status.GoogleCalendar.HasStoredGrant;

    private string AuthorizeUrl => $"{Api.BaseAddress}api/integrations/google/authorize";

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        Loading = true;
        try
        {
            Status = await Api.GetIntegrationStatus();
        }
        catch
        {
            Status = null;
        }
        finally
        {
            Loading = false;
        }
    }
}
