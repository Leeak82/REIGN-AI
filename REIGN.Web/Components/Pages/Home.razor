@page "/"
@page "/dashboard"

@inject ReignApiClient Api

<PageTitle>Overview — REIGN AI</PageTitle>

<div class="hero">
    <h1>@Fmt.Greeting()@(string.IsNullOrWhiteSpace(BusinessName) ? "" : $", {BusinessName}")</h1>
    <p>Here's what REIGN is handling for you.</p>
</div>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="error-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
        <span class="msg">Something went wrong. REIGN couldn't load the overview.</span>
        <button class="btn btn-ghost btn-sm" @onclick="Load">Try again</button>
    </div>
}

@if (Loading)
{
    <div class="loading"><span class="spinner"></span> Loading your command center…</div>
}
else
{
    <div class="grid grid-4">
        <StatCard Label="Conversations"
                  Value="@Customers.Count.ToString()"
                  Note="Customers REIGN has talked with"
                  Icon="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z" />
        <StatCard Label="Waiting"
                  Value="@WaitingCount.ToString()"
                  Note="@(WaitingCount == 0 ? "Nobody is waiting right now" : "Latest message is from the customer")"
                  Icon="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                  Color="linear-gradient(135deg,#f59e0b,#fbbf24)" IconColor="#fbbf24" />
        <StatCard Label="Appointments Today"
                  Value="@TodayAppointments.Count.ToString()"
                  Note="@(ConfirmedToday + " confirmed")"
                  Icon="M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"
                  Color="linear-gradient(135deg,#10b981,#34d399)" IconColor="#34d399" />
        <StatCard Label="AI Activity"
                  Value="@AiReplyCount.ToString()"
                  Note="REIGN replies in recent activity"
                  Icon="M12 2a7 7 0 0 1 7 7c0 2.4-1.2 4-2.6 5.4-.9.9-1.4 1.6-1.4 2.6h-6c0-1-.5-1.7-1.4-2.6C6.2 13 5 11.4 5 9a7 7 0 0 1 7-7Zm-3 19h6"
                  Color="linear-gradient(135deg,#0ea5e9,#38bdf8)" IconColor="#38bdf8" />
    </div>

    <div class="grid mt-3" style="grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: start;">
        <div class="card" style="padding:0;">
            <div class="ws-col-head row-flex">
                <div class="grow">
                    <div class="card-title">Live Inbox</div>
                    <div class="card-sub" style="margin:2px 0 0;">Recent customer conversations</div>
                </div>
                <a class="btn btn-ghost btn-sm" href="inbox">Open inbox</a>
            </div>

            @if (InboxPreview.Count == 0)
            {
                <EmptyState Title="No active conversations"
                            Description="REIGN is ready for your next customer." />
            }
            else
            {
                @foreach (var c in InboxPreview)
                {
                    <a class="list-row" href="inbox?phone=@Uri.EscapeDataString(c.Customer.PhoneNumber)">
                        <span class="avatar">@Fmt.Initials(c.Customer.Name, c.Customer.PhoneNumber)</span>
                        <div class="grow">
                            <div class="conv-top">
                                <span class="conv-name">@Fmt.DisplayName(c.Customer.Name, c.Customer.PhoneNumber)</span>
                                <span class="conv-time">@(c.LastMessage == null ? "" : Fmt.TimeAgo(c.LastMessage.Time))</span>
                            </div>
                            <div class="conv-preview">@(c.LastMessage?.Message ?? "No messages yet")</div>
                            <div class="conv-meta">
                                @if (c.Customer.HumanOverrideActive)
                                {
                                    <StatusBadge Text="Owner speaking" Kind="warning" />
                                }
                                else
                                {
                                    <StatusBadge Text="AI handling" Kind="accent" />
                                }
                                @if (c.Waiting)
                                {
                                    <StatusBadge Text="Waiting" Kind="info" />
                                }
                                @if (!string.IsNullOrWhiteSpace(c.Customer.CurrentIntent))
                                {
                                    <StatusBadge Text="@Fmt.Label(c.Customer.CurrentIntent)" Kind="neutral" />
                                }
                            </div>
                        </div>
                    </a>
                }
            }
        </div>

        <div>
            <div class="card" style="padding:0;">
                <div class="ws-col-head row-flex">
                    <div class="grow">
                        <div class="card-title">Today's Appointments</div>
                        <div class="card-sub" style="margin:2px 0 0;">@DateTime.Now.ToString("dddd, MMMM d")</div>
                    </div>
                    <a class="btn btn-ghost btn-sm" href="calendar">Calendar</a>
                </div>

                @if (TodayAppointments.Count == 0)
                {
                    <EmptyState Title="No appointments today"
                                Description="New bookings REIGN confirms will show up here."
                                Icon="M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
                }
                else
                {
                    @foreach (var a in TodayAppointments)
                    {
                        <div class="list-row" style="cursor:default;">
                            <div class="grow">
                                <div class="cell-main" style="color:var(--text);font-weight:600;">@a.Service · @a.Customer</div>
                                <div class="small faint">@Fmt.AppointmentTime(a.AppointmentTime) · @Fmt.Money(a.Price)</div>
                            </div>
                            <StatusBadge Text="@a.Status" Kind="@StatusBadge.KindForAppointment(a.Status)" />
                        </div>
                    }
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Snapshot))
            {
                <div class="card mt-2">
                    <div class="card-title">REIGN Summary</div>
                    <div class="card-sub">Live snapshot from the owner assistant</div>
                    <p class="dim small" style="white-space:pre-wrap;margin:0;">@Snapshot</p>
                </div>
            }
        </div>
    </div>
}

@code {
    private bool Loading = true;
    private string Error = "";
    private string? BusinessName;
    private string? Snapshot;
    private List<ReignApiClient.CustomerDto> Customers = new();
    private List<ReignApiClient.RecentActivityDto> Recent = new();
    private List<ReignApiClient.AppointmentDto> Appointments = new();

    private List<ReignApiClient.AppointmentDto> TodayAppointments =>
        Appointments
            .Where(a => a.AppointmentTime.Date == DateTime.Today)
            .OrderBy(a => a.AppointmentTime)
            .ToList();

    private int ConfirmedToday => TodayAppointments.Count(a => a.Status == "Confirmed");

    private int WaitingCount => InboxPreview.Count(c => c.Waiting);

    private int AiReplyCount => Recent.Count(r => r.Direction == "Outbound");

    private List<ConversationPreview> InboxPreview
    {
        get
        {
            var latestByCustomer = Recent
                .GroupBy(r => r.Customer)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.Time).First());

            return Customers
                .Take(8)
                .Select(c =>
                {
                    latestByCustomer.TryGetValue(c.PhoneNumber, out var msg);
                    if (msg == null && !string.IsNullOrWhiteSpace(c.Name))
                    {
                        latestByCustomer.TryGetValue(c.Name, out msg);
                    }

                    return new ConversationPreview(c, msg, msg?.Direction == "Inbound");
                })
                .OrderByDescending(c => c.LastMessage?.Time ?? DateTime.MinValue)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        Loading = true;
        Error = "";
        try
        {
            BusinessName = await Api.GetBusinessName();
            Customers = await Api.GetCustomers();
            Appointments = await Api.GetAppointments();
            Recent = await Api.GetRecentActivity();
            Snapshot = await Api.GetActivitySnapshot();
        }
        catch
        {
            Error = "load";
        }
        finally
        {
            Loading = false;
        }
    }

    private record ConversationPreview(
        ReignApiClient.CustomerDto Customer,
        ReignApiClient.RecentActivityDto? LastMessage,
        bool Waiting);
}
