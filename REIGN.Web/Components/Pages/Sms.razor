@page "/sms"

@inject ReignApiClient Api
@inject IWebHostEnvironment HostEnvironment

<PageTitle>SMS — REIGN AI</PageTitle>

<div class="page-head">
    <h1>SMS</h1>
    <p>How REIGN texts with your customers.</p>
</div>

@if (Loading)
{
    <div class="loading"><span class="spinner"></span> Checking SMS…</div>
}
else if (Status == null)
{
    <div class="error-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
        <span class="msg">Something went wrong. REIGN couldn't load SMS status.</span>
        <button class="btn btn-ghost btn-sm" @onclick="Load">Try again</button>
    </div>
}
else
{
    var sms = Status.Sms;
    var connected = sms.CredentialsPresent && !sms.Simulated;

    <div class="grid grid-2" style="align-items:start;">
        <div class="card">
            <div class="row-flex">
                <span class="health-icon @(connected ? "ok" : "warn")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.5 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
                </span>
                <div class="grow">
                    <div class="health-name">SMS Status</div>
                    <div class="health-detail">@(connected ? "Live messaging is active" : "Not connected to a live provider")</div>
                </div>
                <StatusBadge Text="@(connected ? "Connected" : "Not connected")" Kind="@(connected ? "success" : "warning")" />
            </div>

            <div class="divider"></div>

            <div class="kv"><span class="k">Provider</span><span class="v">@sms.ActiveProvider</span></div>
            <div class="kv"><span class="k">Business number</span><span class="v">@(sms.BusinessPhoneConfigured ? (sms.BusinessPhoneDisplay ?? sms.BusinessPhoneNumber) : "Not configured")</span></div>
            <div class="kv"><span class="k">Owner number</span><span class="v">@(sms.OwnerPhoneConfigured ? "•••••• configured" : "Not configured")</span></div>
            <div class="kv"><span class="k">Credentials</span><span class="v">@(sms.CredentialsPresent ? "Configured" : "Missing")</span></div>
            @if (sms.Simulated)
            {
                <div class="kv"><span class="k">Mode</span><span class="v"><StatusBadge Text="Simulated" Kind="info" /></span></div>
            }
        </div>

        <div>
            <div class="card mb-2">
                <div class="card-title">Webhook</div>
                <div class="card-sub">Inbound customer texts reach REIGN here</div>
                <div class="kv">
                    <span class="k">Endpoint</span>
                    <span class="v small">@(sms.Simulated ? "—" : $"/api/sms/webhooks/{sms.ActiveProvider.ToLowerInvariant()}")</span>
                </div>
                <div class="kv">
                    <span class="k">Status</span>
                    <span class="v">
                        @if (connected)
                        {
                            <StatusBadge Text="Configured" Kind="success" />
                        }
                        else
                        {
                            <StatusBadge Text="Not configured" Kind="warning" />
                        }
                    </span>
                </div>
                @if (!sms.Simulated)
                {
                    <p class="small faint mt-1" style="margin-bottom:0;">
                        Point your @sms.ActiveProvider webhook at this URL so customer texts reach REIGN.
                    </p>
                }
            </div>

            <div class="card" style="padding:0;">
                <div class="ws-col-head">
                    <div class="card-title">Recent messaging</div>
                    <div class="card-sub" style="margin:2px 0 0;">Latest inbound and outbound texts</div>
                </div>
                @if (Recent.Count == 0)
                {
                    <EmptyState Title="No messages yet"
                                Description="SMS activity appears here as soon as customers start texting." />
                }
                else
                {
                    @foreach (var m in Recent.Take(8))
                    {
                        <div class="list-row" style="cursor:default;">
                            <span class="feed-icon @(m.Direction == "Inbound" ? "in" : "out")" style="width:32px;height:32px;border-radius:9px;">
                                @if (m.Direction == "Inbound")
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M12 5v14m0 0 5-5m-5 5-5-5"/></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M12 19V5m0 0-5 5m5-5 5 5"/></svg>
                                }
                            </span>
                            <div class="grow">
                                <div class="small" style="font-weight:600;color:var(--text);">@m.Customer <span class="faint" style="font-weight:400;">· @(m.Direction == "Inbound" ? "incoming" : "outgoing")</span></div>
                                <div class="small faint" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:340px;">@m.Message</div>
                            </div>
                            <span class="small faint">@Fmt.TimeAgo(m.Time)</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @if (HostEnvironment.IsDevelopment())
    {
        <div class="card mt-2">
            <div class="card-title">Try a customer text</div>
            <div class="card-sub">Development simulator — same path REIGN uses for live SMS replies</div>
            <label class="field-label" for="sms-phone">From number</label>
            <input id="sms-phone" class="input mb-2" @bind="SimPhone" placeholder="3605550100" />
            <label class="field-label" for="sms-message">Message</label>
            <textarea id="sms-message" class="textarea" @bind="SimMessage" placeholder="Book a QV tomorrow at 2 pm"></textarea>
            <div class="mt-1">
                <button class="btn btn-primary" @onclick="Simulate" disabled="@Busy">Send</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(SimReply))
            {
                <div class="divider"></div>
                <div class="bubble-row out" style="max-width:100%;">
                    <span class="bubble-tag">REIGN</span>
                    <div class="bubble">@SimReply</div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(SimError))
            {
                <p class="small mt-1" style="color:var(--danger);margin-bottom:0;">@SimError</p>
            }
        </div>
    }
}

@code {
    private bool Loading = true;
    private bool Busy;
    private ReignApiClient.IntegrationStatusDto? Status;
    private List<ReignApiClient.RecentActivityDto> Recent = new();
    private string SimPhone = "3605550100";
    private string SimMessage = "";
    private string SimReply = "";
    private string SimError = "";

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        Loading = true;
        try
        {
            Status = await Api.GetIntegrationStatus();
            Recent = await Api.GetRecentActivity();
        }
        catch
        {
            Status = null;
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task Simulate()
    {
        SimError = "";
        SimReply = "";
        if (string.IsNullOrWhiteSpace(SimPhone) || string.IsNullOrWhiteSpace(SimMessage))
        {
            SimError = "Phone and message are required.";
            return;
        }

        Busy = true;
        try
        {
            var result = await Api.ChatAsync(SimPhone.Trim(), SimMessage.Trim());
            if (!string.IsNullOrWhiteSpace(result.Error))
            {
                SimError = result.Error;
                return;
            }

            SimReply = result.Reply ?? "No response.";
            SimMessage = "";
            Recent = await Api.GetRecentActivity();
        }
        finally
        {
            Busy = false;
        }
    }
}
