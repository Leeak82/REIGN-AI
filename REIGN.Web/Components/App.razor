<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["REIGN.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script>
        window.reignUi = {
            setValue: function (id, value) {
                var el = document.getElementById(id);
                if (el) { el.value = value; el.dispatchEvent(new Event('input', { bubbles: true })); }
            },
            alertsEnabled: function () {
                return window.localStorage.getItem('reign-alerts-enabled') === '1';
            },
            setAlertsEnabled: async function (enabled) {
                if (!enabled) {
                    window.localStorage.setItem('reign-alerts-enabled', '0');
                    return 'disabled';
                }

                if ('Notification' in window && Notification.permission === 'default') {
                    await Notification.requestPermission();
                }

                window.localStorage.setItem('reign-alerts-enabled', '1');
                window.reignUi.playReignTone('ready');
                return !('Notification' in window) ? 'sound-only' : Notification.permission;
            },
            playReignTone: function (kind) {
                try {
                    var AudioContext = window.AudioContext || window.webkitAudioContext;
                    if (!AudioContext) return;
                    var ctx = window.reignAudioContext || new AudioContext();
                    window.reignAudioContext = ctx;
                    if (ctx.state === 'suspended') ctx.resume();
                    var now = ctx.currentTime;
                    var notes = kind === 'booking' ? [660, 880, 1040] : kind === 'customer' ? [520, 740] : [620, 780];
                    notes.forEach(function (frequency, index) {
                        var osc = ctx.createOscillator();
                        var gain = ctx.createGain();
                        osc.type = 'sine';
                        osc.frequency.value = frequency;
                        gain.gain.setValueAtTime(0.0001, now + index * 0.12);
                        gain.gain.exponentialRampToValueAtTime(0.12, now + index * 0.12 + 0.015);
                        gain.gain.exponentialRampToValueAtTime(0.0001, now + index * 0.12 + 0.11);
                        osc.connect(gain);
                        gain.connect(ctx.destination);
                        osc.start(now + index * 0.12);
                        osc.stop(now + index * 0.12 + 0.12);
                    });
                } catch (_) { }
            },
            alertActivity: function (kind, title, body) {
                if (!window.reignUi.alertsEnabled()) return;
                window.reignUi.playReignTone(kind || 'reign');
                if ('Notification' in window && Notification.permission === 'granted') {
                    try {
                        new Notification(title || 'REIGN activity', {
                            body: body || 'REIGN handled new customer activity.',
                            icon: '/favicon.png',
                            tag: 'reign-' + (kind || 'activity')
                        });
                    } catch (_) { }
                }
            }
        };
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
