# Local Docker OAuth callback. Loaded by docker-compose.yml.
# Literal values — Compose will not substitute host GOOGLE_REDIRECT_URI / GoogleCalendar__RedirectUri.
# Do not put Client ID, Client Secret, or other secrets in this file.
REIGN_DOCKER=1
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
GoogleCalendar__RedirectUri=http://localhost:8080/api/integrations/google/callback
